<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.leese.usercenter.mapper.OrderItemMapper">

    <resultMap id="BaseResultMap" type="com.leese.usercenter.model.entity.OrderItemEntity">
        <id property="id" column="id"/>
        <result property="orderId" column="orderId"/>
        <result property="dishId" column="dishId"/>
        <result property="dishName" column="dishName"/>
        <result property="dishFlavor" column="dishFlavor"/>
        <result property="quantity" column="quantity"/>
        <result property="price" column="price"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, orderId, dishId, dishName, dishFlavor, quantity, price
    </sql>

    <select id="findByOrderId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM order_items
        WHERE orderId = #{orderId}
    </select>

    <!-- 示例：更新数量和价格 -->
    <update id="updateOrderItem">
        UPDATE order_items
        SET quantity = #{quantity}, price = #{price}
        WHERE id = #{id}
    </update>

</mapper>
