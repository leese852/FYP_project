<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.leese.usercenter.mapper.OrderMapper">

    <resultMap id="BaseResultMap" type="com.leese.usercenter.model.entity.OrderEntity">
        <id property="id" column="id"/>
        <result property="orderId" column="orderId"/>
        <result property="userId" column="userId"/>
        <result property="addressId" column="addressId"/>
        <result property="status" column="status"/>
        <result property="totalAmount" column="totalAmount"/>
        <result property="payMethod" column="payMethod"/>
        <result property="payStatus" column="payStatus"/>
        <result property="remark" column="remark"/>
        <result property="cancelReason" column="cancelReason"/>
        <result property="cancelTime" column="cancelTime"/>
        <result property="rejectionReason" column="rejectionReason"/>
        <result property="estimatedDeliveryTime" column="estimatedDeliveryTime"/>
        <result property="deliveryStatus" column="deliveryStatus"/>
        <result property="deliveryTime" column="deliveryTime"/>
        <result property="packAmount" column="packAmount"/>
        <result property="createTime" column="createTime"/>
        <result property="updateTime" column="updateTime"/>
        <result property="isDelete" column="isDelete"/>
        <result property="employeeId" column="employeeId"/>
        <result property="rideAddress" column="rideAddress"/>
        <result property="orderComment" column="orderComment"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, orderId, userId, addressId, status, totalAmount, payMethod, payStatus,
        remark, cancelReason, cancelTime, rejectionReason, estimatedDeliveryTime,
        deliveryStatus, deliveryTime, packAmount, createTime, updateTime, isDelete,
        employeeId, rideAddress, orderComment
    </sql>

    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM orders
        WHERE id = #{id}
    </select>

    <select id="findByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM orders
        WHERE userId = #{userId}
    </select>

    <insert id="save" parameterType="com.leese.usercenter.model.entity.OrderEntity">
        INSERT INTO orders (orderId, userId, addressId, status, totalAmount, payMethod, payStatus,
                            remark, cancelReason, cancelTime, rejectionReason, estimatedDeliveryTime,
                            deliveryStatus, deliveryTime, packAmount, employeeId, rideAddress, orderComment)
        VALUES (#{orderId}, #{userId}, #{addressId}, #{status}, #{totalAmount}, #{payMethod}, #{payStatus},
                #{remark}, #{cancelReason}, #{cancelTime}, #{rejectionReason}, #{estimatedDeliveryTime},
                #{deliveryStatus}, #{deliveryTime}, #{packAmount}, #{employeeId}, #{rideAddress}, #{orderComment})
    </insert>

    <update id="updateStatus">
        UPDATE orders
        SET status = #{status}
        WHERE id = #{id}
    </update>

    <update id="assignRider">
        UPDATE orders
        SET employeeId = #{employeeId}
        WHERE id = #{orderId}
    </update>

</mapper>
